{
  "campaignId": "cosmos-cross-sdk-perf",
  "azure": {
    "subscriptionId": "",
    "resourceGroup": "",
    "location": "",
    "existingCosmosAccountResourceId": "",
    "provisionCosmosAccount": false,
    "cosmosAccountName": "",
    "database": "cosmos-perf-db",
    "container": "perfcontainer",
    "provisionDatabaseContainer": false,
    "throughput": 10000,
    "vmName": "cosmos-perf-vm",
    "vmSku": "",
    "adminUsername": "azureuser",
    "cleanup": "all-campaign-owned"
  },
  "sources": {
    "goV1Module": "github.com/Azure/azure-sdk-for-go/sdk/data/azcosmos",
    "goV1Version": "v1.5.0",
    "goV2Repository": "https://github.com/Azure/azure-sdk-for-go.git",
    "goV2Commit": "7201f4b70fac1184e66379278566f1ac8d299109",
    "nativeDriverSourceRepository": "https://github.com/Azure/azure-sdk-for-rust.git",
    "nativeDriverSourceCommit": "62192bf69dac1a3384505971d7deef19eb8282df",
    "nativeDriverDistributionRepository": "https://github.com/Azure/azure-cosmos-driver.git",
    "nativeDriverDistributionCommit": "1e449be78bffef6ef99e6bc1810216a84a9dac16",
    "rustRepository": "https://github.com/Azure/azure-sdk-for-rust.git",
    "rustCommit": "f87618c80049eab5fd1ed8f16c7cf37488f43663",
    "flameGraphRepository": "https://github.com/brendangregg/FlameGraph.git",
    "flameGraphCommit": "41fee1f99f9276008b7cd112fca19dc3ea84ac32"
  },
  "workload": {
    "partitionKeyPath": "/pk",
    "seedCount": 1024,
    "documentBytes": 1024,
    "operation": "point-read",
    "workers": [8, 16],
    "warmupSeconds": 30,
    "measurementSeconds": 300,
    "closedLoop": true,
    "keySequence": "round-robin-0-through-1023",
    "rawResponseMode": true,
    "validationOutsideTimedPath": true,
    "gatewayProtocol": "GatewayV1HTTP2",
    "binaryEncoding": false,
    "authentication": "account-key",
    "requiredRetries": 0,
    "requiredThrottles": 0
  },
  "execution": {
    "cleanRepeats": 2,
    "order": {
      "8": ["go-v1", "go-v2-native", "rust"],
      "16": ["rust", "go-v2-native", "go-v1"]
    },
    "runClasses": ["clean-score", "perf", "go-diagnostic"],
    "authoritativeClass": "clean-score",
    "stopAfterPilot": true
  },
  "profiling": {
    "perfFrequencyHz": 49,
    "calibrationModes": ["frame-pointer", "dwarf,16384"],
    "selectedCallGraph": "",
    "capacityCores": 4,
    "accountingTolerancePercent": 0.25,
    "maxLostEventPercent": 0.1,
    "minResolvedSamplePercent": 95,
    "minCallchainSamplePercent": 95
  }
}
