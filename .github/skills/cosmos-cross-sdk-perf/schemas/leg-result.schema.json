{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cosmos cross-SDK performance leg result",
  "type": "object",
  "required": [
    "leg",
    "runClass",
    "workers",
    "repeat",
    "workload",
    "transportProof",
    "counts",
    "timing",
    "latencyMilliseconds",
    "memoryBytes",
    "gauges"
  ],
  "properties": {
    "leg": {"enum": ["go-v1", "go-v2-native", "rust"]},
    "runClass": {"enum": ["clean-score", "perf", "go-diagnostic"]},
    "workers": {"enum": [8, 16]},
    "repeat": {"type": "integer", "minimum": 1},
    "workload": {
      "type": "object",
      "required": [
        "partitionKeyPath",
        "seedCount",
        "documentBytes",
        "cycle",
        "workers",
        "warmupSeconds",
        "measurementSeconds",
        "closedLoop",
        "gatewayProtocol",
        "binaryEncoding",
        "authentication"
      ]
    },
    "transportProof": {
      "type": "object",
      "required": ["transportKind", "negotiatedHTTPVersion", "binaryEncoding"],
      "properties": {
        "transportKind": {"const": "gateway-v1"},
        "negotiatedHTTPVersion": {"const": "HTTP/2"},
        "binaryEncoding": {"const": false}
      }
    },
    "counts": {
      "type": "object",
      "required": ["success", "error", "retry", "throttle"],
      "properties": {
        "success": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "retry": {"type": "integer", "minimum": 0},
        "throttle": {"type": "integer", "minimum": 0}
      }
    },
    "timing": {
      "type": "object",
      "required": ["wallSeconds", "processCPUSeconds"],
      "properties": {
        "wallSeconds": {"type": "number", "exclusiveMinimum": 0},
        "processCPUSeconds": {"type": "number", "minimum": 0}
      }
    },
    "latencyMilliseconds": {
      "type": "object",
      "required": ["p50", "p90", "p95", "p99", "p999"],
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "queueDelayMilliseconds": {"type": ["object", "null"]},
    "memoryBytes": {
      "type": "object",
      "required": ["rss", "hwm", "anonymous", "file", "cgroupCurrent", "cgroupPeak"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "gauges": {
      "type": "object",
      "required": ["queueHighWater", "inFlightHighWater", "completionHighWater"],
      "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
    }
  }
}
