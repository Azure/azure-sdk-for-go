{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cosmos cross-SDK performance build provenance",
  "type": "object",
  "required": [
    "leg",
    "source",
    "compiler",
    "buildCommand",
    "dependencyVersions",
    "binary"
  ],
  "properties": {
    "leg": {"enum": ["go-v1", "go-v2-native", "rust"]},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tree", "dirty"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"const": false}
      }
    },
    "compiler": {"type": "object", "minProperties": 1},
    "buildCommand": {"type": ["string", "array"]},
    "dependencyVersions": {"type": "object", "minProperties": 1},
    "binary": {
      "type": "object",
      "required": ["sha256", "buildId", "debugSymbols"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "buildId": {"type": "string", "minLength": 1},
        "debugSymbols": {"enum": ["embedded", "separate"]}
      }
    },
    "nativeDriver": {
      "type": "object",
      "required": ["sourceCommit", "distributionCommit", "archiveSha256", "buildId"]
    }
  }
}
