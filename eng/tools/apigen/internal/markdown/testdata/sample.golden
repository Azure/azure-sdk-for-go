	CodeAlpha Code = 1
	CodeZulu Code = 2
)

type ETag string

const (
	ETagAny ETag = "*"
	ETagZulu ETag = "z"
)

func NewETag(value string) ETag
func PossibleETagValues() []ETag

func (ETag) String() string

var (
	// Inferred type of Alternate: Config
	Alternate = Config{Value: nil}
	// Inferred type of Default: Config
	Default = Config{}
)

func GetRecord[T any](value T) Record
func Identity[T any](value T) T

type AContract = ZContract

// Alias of example.com/sample/v2/internal/model.Contract.
