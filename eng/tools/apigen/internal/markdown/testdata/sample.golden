	Alpha()
	Zulu()
}

type ZContract interface {
	Alpha()
	Zulu()
}

type Client struct {
	// contains filtered or unexported fields
}

func NewClient() (*Client, error)

func (*Client) Send(ctx context.Context, value string) error

