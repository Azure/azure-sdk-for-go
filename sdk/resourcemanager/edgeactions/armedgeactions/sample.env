# Copy this file to .env and fill in your test subscription before recording or live tests.
# Do not commit .env. Existing shell and CI environment variables take precedence.

# An authorized subscription enabled for Microsoft.Cdn Edge Actions.
AZURE_SUBSCRIPTION_ID=<your-test-subscription-id>

# Resource group location; the Edge Actions resources themselves use global.
LOCATION=eastus

# For local authentication, sign in with az login.
# Set AZURE_RECORD_MODE and PROXY_CERT in the shell before go test, not in this file.
